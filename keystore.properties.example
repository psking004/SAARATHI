# Copy to keystore.properties (gitignored) to sign release builds:
#   cp keystore.properties.example keystore.properties
# Without keystore.properties (or the KEYSTORE_PATH/STORE_PASSWORD/KEY_PASSWORD env vars),
# ./gradlew assembleRelease still builds, but produces an UNSIGNED APK.
# storeFile may be absolute or relative to the project root.
storeFile=/absolute/path/to/upload-key.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
